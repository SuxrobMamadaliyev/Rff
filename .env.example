# ===========================================
#  Premium Shop Bot - Environment variables
#  Copy this file to ".env" and fill the values.
# ===========================================

# --- Telegram ---
# Get the token from @BotFather
BOT_TOKEN=123456789:AAExampleBotTokenReplaceMe
# Bot username WITHOUT @ (used to build referral links)
BOT_USERNAME=YourBotUsername

# --- Admins ---
# Comma separated list of Telegram numeric user IDs that have admin access
ADMIN_IDS=123456789,987654321

# --- Mandatory subscription channels ---
# Two channels the user must join before using the bot.
# Use @username for public channels, or a numeric -100... id for private ones.
REQUIRED_CHANNEL_1=@your_channel_1
REQUIRED_CHANNEL_2=@your_channel_2
# Public invite links shown to the user (buttons)
REQUIRED_CHANNEL_1_LINK=https://t.me/your_channel_1
REQUIRED_CHANNEL_2_LINK=https://t.me/your_channel_2

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/premium_shop_bot

# --- Business / economy ---
# Default currency label shown to users
CURRENCY=so'm
# Referral bonus credited to the inviter for each new referred user
REFERRAL_BONUS=5000
# Minimum amount a user can withdraw
MIN_WITHDRAWAL=10000

# --- Premium prices (in CURRENCY) ---
PRICE_3_MONTHS=120000
PRICE_6_MONTHS=210000
PRICE_12_MONTHS=380000

# --- Payment provider hints (shown to the user) ---
CARD_NUMBER=8600 1234 5678 9012
CARD_HOLDER=John Doe
CLICK_LINK=https://my.click.uz/services/pay
PAYME_LINK=https://payme.uz
UZUM_LINK=https://www.uzumbank.uz
# Telegram Stars price per plan (XTR). Set to 0 to disable Stars for a plan.
STARS_3_MONTHS=500
STARS_6_MONTHS=900
STARS_12_MONTHS=1600

# --- Security / anti-spam ---
# Max messages allowed inside the RATE_LIMIT_WINDOW_MS window
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=10000

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info
